<?xml version="1.0" encoding="utf-8"?>
<!-- xara for Android: the modem (TNC or passive monitor) and, when bundled, Pat, run as executables from the
     app's native library directory under a foreground microphone service. Built by build_apk.py. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.xara.app">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- sockets, loopback included: the TNC ports, the web UIs and Pat -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- extractNativeLibs: the modem and Pat are executables, so they must exist as files to exec -->
    <application
        android:label="xara"
        android:icon="@drawable/ic_xara"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- offered when a USB sound card is plugged in -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio" />
        </activity>

        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".XaraService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
